#!/usr/bin/perl
# ============================================================================
# HB Perl CLI - Command line interface for the HB Perl toolkit
# ============================================================================
use strict;
use warnings;
use utf8;
use FindBin qw($RealBin);
use lib "$RealBin/../lib";
use File::Basename qw(basename);
use File::Spec;
use PerlDen::ScriptRegistry qw(script_index find_script find_closest find_top_n plugins_dir);

my $SCRIPTS_DIR = File::Spec->catdir($RealBin, '..', 'scripts');
my $PROGRAM     = $ENV{HB_LAUNCH_NAME} || basename($0);

my $command = shift @ARGV // 'help';

# Allow shorthand invocation: `hb_cli system_info`
if ($command !~ /^(?:help|--help|-h|list|run|batch|ide|plugin|schedule)$/) {
    unshift @ARGV, $command;
    $command = 'run';
}

if ($command eq 'help' || $command eq '--help' || $command eq '-h') {
    _print_help();
    exit 0;
}

if ($command eq 'list') {
    _list_scripts();
    exit 0;
}

if ($command eq 'run') {
    my $name = shift @ARGV;
    if (!$name) {
        warn "Missing script name. Try: $PROGRAM list\n";
        exit 2;
    }

    my $script_path = _resolve_script_path($name);
    if (!$script_path) {
        warn "Unknown script: '$name'\n";
        my @suggestions = find_top_n($name, 3);
        if (@suggestions == 1) {
            warn "Did you mean: $suggestions[0]?\n";
        } elsif (@suggestions > 1) {
            warn "Did you mean one of: " . join(', ', map { "'$_'" } @suggestions) . "?\n";
        }
        warn "Run '$PROGRAM list' to see available scripts.\n";
        exit 2;
    }

    exec $^X, $script_path, @ARGV;
    die "Failed to execute $script_path: $!";
}

if ($command eq 'batch') {
    # Parse --export=FORMAT and --dry-run options
    my ($export_format, $dry_run);
    @ARGV = grep {
        /^--export=(.+)$/ ? do { $export_format = $1; 0 } :
        /^--dry-run$/     ? do { $dry_run = 1;        0 } : 1
    } @ARGV;

    my $names_arg = shift @ARGV;
    if (!$names_arg) {
        warn "Usage: $PROGRAM batch [--export=text|html|json] <script1,script2,...>\n";
        warn "Example: $PROGRAM batch system_info,disk_usage,config_diff\n";
        exit 2;
    }
    my @names = split /,/, $names_arg;
    @names = grep { length } @names;
    if (!@names) {
        warn "No valid script names given.\n";
        exit 2;
    }

    # Dry-run: resolve and print paths without executing
    if ($dry_run) {
        print "Dry run \x{2014} would execute:\n";
        my $all_ok = 1;
        for my $n (@names) {
            my $path = _resolve_script_path($n);
            if ($path) {
                printf "  \x{2713} %-25s -> %s\n", $n, $path;
            } else {
                $all_ok = 0;
                printf "  \x{2717} %-25s (unknown script)\n", $n;
                my @sug = find_top_n($n, 2);
                print "      Did you mean: " . join(' or ', map { "'$_'" } @sug) . "?\n" if @sug;
            }
        }
        exit($all_ok ? 0 : 2);
    }

    require PerlDen::BatchRunner;
    my $runner = PerlDen::BatchRunner->new(
        on_progress => sub {
            my ($name, $i, $total) = @_;
            printf STDERR "  [%d/%d] Running %s ...\n", $i, $total, $name;
        },
        on_error => sub {
            my ($name, $err) = @_;
            warn "  ERROR in $name: $err\n";
        },
    );
    my $results = $runner->run_batch(@names);
    if ($export_format && $export_format ne 'text') {
        print $runner->export_report($results, format => $export_format);
    } else {
        print $runner->format_batch_report($results);
    }
    exit 0;
}

if ($command eq 'ide') {
    my $ide = File::Spec->catfile($RealBin, 'perlden-ide');
    exec $^X, $ide, @ARGV;
    die "Failed to launch IDE: $!";
}

# ── Plugin management ────────────────────────────────────────────────────────
if ($command eq 'plugin') {
    my $sub = shift @ARGV // 'list';

    if ($sub eq 'list') {
        _plugin_list();
        exit 0;
    }

    if ($sub eq 'info') {
        my $name = shift @ARGV or do {
            warn "Usage: $PROGRAM plugin info <name>\n";
            exit 2;
        };
        _plugin_info($name);
        exit 0;
    }

    if ($sub eq 'enable' || $sub eq 'disable') {
        my $name = shift @ARGV or do {
            warn "Usage: $PROGRAM plugin $sub <name>\n";
            exit 2;
        };
        _plugin_toggle($name, $sub eq 'disable');
        exit 0;
    }

    warn "Unknown plugin subcommand: $sub\n";
    warn "Valid: list info enable disable\n";
    exit 2;
}

# ── Script scheduling ────────────────────────────────────────────────────────
if ($command eq 'schedule') {
    my $sub = shift @ARGV // 'list';
    require PerlDen::Scheduler;

    if ($sub eq 'list') {
        my @jobs = PerlDen::Scheduler::list_jobs();
        if (!@jobs) {
            print "No scheduled HB Perl jobs.\n";
        } else {
            printf "%-30s %-20s %-10s %s\n", 'Script', 'Schedule', 'Status', 'Args';
            print '-' x 75, "\n";
            for my $j (@jobs) {
                my $status = $j->{enabled} ? 'enabled' : 'DISABLED';
                printf "%-30s %-20s %-10s %s\n",
                    $j->{script}, $j->{schedule}, $status, $j->{args} // '';
            }
        }
        exit 0;
    }

    if ($sub eq 'add') {
        my ($script, $schedule, @args) = @ARGV;
        unless ($script && $schedule) {
            warn "Usage: $PROGRAM schedule add <script> <cron_expr> [args...]\n";
            warn "Example: $PROGRAM schedule add system_info '0 * * * *'\n";
            exit 2;
        }
        PerlDen::Scheduler::add_job(
            script   => $script,
            schedule => $schedule,
            args     => join(' ', @args),
        );
        print "Scheduled '$script' with cron expression '$schedule'.\n";
        exit 0;
    }

    if ($sub eq 'remove') {
        my $script = shift @ARGV or do {
            warn "Usage: $PROGRAM schedule remove <script>\n";
            exit 2;
        };
        my $removed = PerlDen::Scheduler::remove_job($script);
        if ($removed) {
            print "Removed scheduled job for '$script'.\n";
        } else {
            warn "No scheduled job found for '$script'.\n";
            exit 1;
        }
        exit 0;
    }

    if ($sub eq 'enable' || $sub eq 'disable') {
        my $script = shift @ARGV or do {
            warn "Usage: $PROGRAM schedule $sub <script>\n";
            exit 2;
        };
        my $ok = eval {
            $sub eq 'enable'
                ? PerlDen::Scheduler::enable_job($script)
                : PerlDen::Scheduler::disable_job($script);
            1;
        };
        if (!$ok) {
            chomp(my $err = $@);
            warn "$err\n";
            exit 1;
        }
        print ucfirst($sub) . "d scheduled job for '$script'.\n";
        exit 0;
    }

    warn "Unknown schedule subcommand: $sub\n";
    warn "Valid: list add remove enable disable\n";
    exit 2;
}

warn "Unknown command: $command\n";
_print_help();
exit 2;

sub _resolve_script_path {
    my ($raw_name) = @_;
    return undef if !defined $raw_name || $raw_name eq '';

    my @match = find_script($raw_name);
    return undef unless @match;

    my $path = File::Spec->catfile($SCRIPTS_DIR, $match[1]);
    return -f $path ? $path : undef;
}

sub _plugin_list {
    require PerlDen::ScriptRegistry;
    my $dir = plugins_dir();
    unless (-d $dir) {
        print "No plugins directory found ($dir).\n";
        print "Create it and place .pm files there to install plugins.\n";
        return;
    }
    opendir(my $dh, $dir) or die "Cannot read $dir: $!\n";
    my @pm = sort grep { /\.pm$/ } readdir $dh;
    closedir $dh;
    if (!@pm) {
        print "No plugins installed in $dir.\n";
        return;
    }
    require PerlDen::Config;
    PerlDen::Config::load();
    my %disabled = map { $_ => 1 } @{ PerlDen::Config::get('disabled_plugins') // [] };
    printf "%-25s %-12s %s\n", 'Plugin', 'Status', 'File';
    print '-' x 60, "\n";
    for my $f (@pm) {
        my $status = $disabled{$f} ? 'disabled' : 'enabled';
        printf "%-25s %-12s %s\n", ($f =~ s/\.pm$//r), $status, $f;
    }
}

sub _plugin_info {
    my ($name) = @_;
    my $dir  = plugins_dir();
    my $file = "$dir/$name.pm";
    $file .= '.pm' unless $name =~ /\.pm$/;
    unless (-f $file) {
        warn "Plugin not found: $name\n";
        exit 1;
    }
    # Parse comment headers
    if (open my $fh, '<', $file) {
        my %meta;
        while (<$fh>) {
            last if $. > 30;
            $meta{$1} = (split /:\s*/, $_, 2)[1] if /^#\s*(Name|Description|Version|Author|Category):/i;
        }
        close $fh;
        for my $k (qw(Name Version Author Category Description)) {
            printf "%-14s %s\n", "$k:", $meta{lc $k} // 'N/A' if exists $meta{lc $k};
        }
    }
}

sub _plugin_toggle {
    my ($name, $disable) = @_;
    require PerlDen::Config;
    PerlDen::Config::load();
    my $list = PerlDen::Config::get('disabled_plugins') // [];
    my %d = map { $_ => 1 } @$list;
    $name =~ s/\.pm$//;
    if ($disable) {
        $d{$name} = 1;
        print "Plugin '$name' disabled.\n";
    } else {
        delete $d{$name};
        print "Plugin '$name' enabled.\n";
    }
    PerlDen::Config::set('disabled_plugins', [ sort keys %d ]);
    PerlDen::Config::save();
}

sub _list_scripts {
    print "HB Perl CLI scripts\n";
    print "=" x 80, "\n";
    printf "%-22s %-12s %s\n", 'Script', 'Category', 'Description';
    print "-" x 80, "\n";

    for my $row (script_index()) {
        my ($name, $file, $module, $desc, $category) = @$row;
        my $stem = $file; $stem =~ s/\.pl$//;
        printf "%-22s %-12s %s\n", $stem, $category, $desc;
    }

    print "\nExamples:\n";
    print "  $PROGRAM run system_info\n";
    print "  $PROGRAM run port_scanner -- --host 127.0.0.1\n";
    print "  $PROGRAM batch system_info,disk_usage,config_diff\n";
    print "  $PROGRAM ide\n";
}

sub _print_help {
    my $ver = $PerlDen::ScriptRegistry::VERSION // 'unknown';
    print <<HELP;
HB Perl CLI v$ver

Usage:
  $PROGRAM list
      List all scripts (built-in, plugins, and user scripts).

  $PROGRAM run <script_name> [-- <script_args...>]
      Run a script by name (fuzzy match supported).
      Name accepts underscore or hyphen style, with or without .pl.

  $PROGRAM batch [--export=text|html|json] [--dry-run] <script1,script2,...>
      Run multiple scripts sequentially and aggregate reports.
      Names are comma-separated (no spaces).
      Use --export=html or --export=json to write a structured report.
      Use --dry-run to preview resolved paths without executing.

  $PROGRAM plugin list
      List installed plugins and their enabled/disabled status.

  $PROGRAM plugin info <name>
      Show metadata for a plugin.

  $PROGRAM plugin enable <name>
      Enable a previously disabled plugin.

  $PROGRAM plugin disable <name>
      Disable a plugin without removing it.

  $PROGRAM schedule list
      List all scheduled HB Perl jobs (from crontab).

  $PROGRAM schedule add <script> <cron_expr> [args...]
      Schedule a script via crontab.
      Example: $PROGRAM schedule add disk_usage '0 * * * *'

  $PROGRAM schedule remove <script>
      Remove a scheduled job from crontab.

  $PROGRAM schedule disable <script>
      Disable a job without removing it (preserves schedule).

  $PROGRAM schedule enable <script>
      Re-enable a previously disabled job.

  $PROGRAM ide
      Launch the GTK IDE.

  $PROGRAM help
      Show this help.
HELP
}

__END__

=head1 NAME

perlden-cli - Command-line interface for the HB Perl toolkit

=head1 SYNOPSIS

    perlden-cli list
    perlden-cli run <script_name> [-- <args>]
    perlden-cli batch <script1,script2,...>
    perlden-cli ide
    perlden-cli help

=head1 DESCRIPTION

A command-line front-end for running the 15 bundled sysadmin scripts.
Script names accept underscore or hyphen style, with or without F<.pl>.

Shorthand invocation is supported: C<perlden-cli system_info> is
equivalent to C<perlden-cli run system_info>.

=head1 COMMANDS

=over 4

=item B<list>

Print a table of all available toolkit scripts.

=item B<run E<lt>nameE<gt> [-- E<lt>argsE<gt>]>

Execute a toolkit script by name.  Any arguments after C<--> are
passed to the script.

=item B<batch E<lt>script1,script2,...E<gt>>

Run multiple scripts sequentially using their module C<run()> functions
and print an aggregated report.  Names are comma-separated.

=item B<ide>

Launch the GTK-based IDE (L<perlden-ide>).

=item B<help>

Show the built-in usage summary.

=back

=head1 AUTHOR

James

