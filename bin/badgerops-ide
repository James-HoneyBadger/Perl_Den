#!/usr/bin/perl
# ============================================================================
# BadgerOps IDE - Linux Sysadmin Toolkit & Perl Development Environment
# ============================================================================
use strict;
use warnings;
use utf8;
use FindBin qw($RealBin);
use lib "$RealBin/../lib";
use Getopt::Long;

my $show_help;
my $show_version;
Getopt::Long::Configure('pass_through');
GetOptions(
    'help|h'    => \$show_help,
    'version|v' => \$show_version,
);

if ($show_help) {
    print <<'HELP';
Usage: badgerops-ide [OPTIONS] [FILE ...]

Launches the BadgerOps IDE - a GTK3-based Perl development environment
with integrated Linux system administration tools.

Options:
  -h, --help       Show this help message
  -v, --version    Show version number

Files passed on the command line will be opened in editor tabs.
HELP
    exit 0;
}

use BadgerOps::App;

if ($show_version) {
    print "BadgerOps IDE v$BadgerOps::App::VERSION\n";
    exit 0;
}

my $app = BadgerOps::App->new;
$app->{open_files} = [@ARGV] if @ARGV;  # Pass files to open
$app->run;

__END__

=encoding utf8

=head1 NAME

badgerops-ide - BadgerOps IDE launcher

=head1 SYNOPSIS

    badgerops-ide [OPTIONS] [FILE ...]

=head1 DESCRIPTION

Launches the BadgerOps IDE — a professional GTK3-based Perl development
environment with integrated Linux system administration tools.  Files
passed on the command line are opened as editor tabs on startup.

=head1 OPTIONS

=over 4

=item B<-h>, B<--help>

Print a usage summary and exit.

=item B<-v>, B<--version>

Print the version number and exit.

=back

=head1 SEE ALSO

L<BadgerOps::App>, L<badgerops-cli>, L<badgerops-tui>

