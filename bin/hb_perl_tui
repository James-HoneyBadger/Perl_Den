#!/usr/bin/perl
# ============================================================================
# HB Perl TUI - Terminal UI launcher for HB Perl toolkit
# ============================================================================
use strict;
use warnings;
use utf8;
use FindBin qw($RealBin);
use lib "$RealBin/../lib";
use File::Basename qw(basename);
use File::Spec;
use HBPerl::ScriptRegistry qw(script_index);

my $SCRIPTS_DIR = File::Spec->catdir($RealBin, '..', 'scripts');
my $CLI_BIN     = File::Spec->catfile($RealBin, 'hb_perl_cli');
my $IDE_BIN     = File::Spec->catfile($RealBin, 'hb_perl_ide');
my $PROGRAM     = $ENV{HB_LAUNCH_NAME} || basename($0);

# Build tool list from shared registry: [display_name, filename, category, description]
my @ALL_TOOLS = map { [ $_->[0], $_->[1], $_->[3] // '', $_->[4] // '' ] } script_index();

sub _clear {
    print "\e[2J\e[H";
}

sub _banner {
    print "=============================================\n";
    print "           HB Perl Toolkit (TUI)            \n";
    print "=============================================\n\n";
}

sub _pause {
    print "\nPress Enter to continue... ";
    scalar <STDIN>;
}

sub _run_tool {
    my ($script) = @_;
    my $path = File::Spec->catfile($SCRIPTS_DIR, $script);

    if (!-f $path) {
        print "\n[ERROR] Script not found: $path\n";
        _pause();
        return;
    }

    print "\nRunning: $script\n";
    print "---------------------------------------------\n\n";
    system($^X, $path);
    print "\n---------------------------------------------\n";
    print "Exit code: " . (($? >> 8) // 0) . "\n";
    _pause();
}

sub _show_tool_menu {
    my ($filter) = @_;
    $filter //= '';

    while (1) {
        # Apply filter
        my @tools = $filter
            ? grep { $_->[0] =~ /\Q$filter\E/i || $_->[3] =~ /\Q$filter\E/i } @ALL_TOOLS
            : @ALL_TOOLS;

        _clear();
        _banner();

        if ($filter) {
            printf "Filter: \e[33m%s\e[0m  (%d result%s)\n\n",
                $filter, scalar @tools, @tools == 1 ? '' : 's';
        } else {
            print "Select a toolkit script:\n\n";
        }

        if (!@tools) {
            print "  (no scripts match)\n";
        } else {
            for my $i (0 .. $#tools) {
                printf "  %2d) %-30s \e[2m%s\e[0m\n",
                    $i + 1, $tools[$i][0], $tools[$i][2];
            }
        }

        print "\n  [/] search  [c] clear filter  [b] back\n";
        print "\nChoice: ";
        my $line = <STDIN>;
        unless (defined $line) { print "\nGoodbye.\n"; exit 0 }
        chomp(my $choice = $line);

        if ($choice eq '/') {
            print "Search: ";
            my $q = <STDIN>;
            chomp $q if defined $q;
            $filter = $q // '';
            next;
        }

        if ($choice =~ /^[cC]$/) {
            $filter = '';
            next;
        }

        if ($choice =~ /^[bB]$/) {
            return;
        }

        if ($choice =~ /^\d+$/ && @tools && $choice >= 1 && $choice <= @tools) {
            _run_tool($tools[$choice - 1][1]);
            next;
        }

        print "\nInvalid selection.\n";
        _pause();
    }
}

sub _help {
    print <<HELP;
HB Perl TUI

Menu options:
  1) Run toolkit scripts
  2) List scripts (via CLI)
  3) Launch IDE
  4) Exit

You can also run:
    $PROGRAM --help
HELP
}

if (grep { $_ eq '--help' || $_ eq '-h' } @ARGV) {
    _help();
    exit 0;
}

while (1) {
    _clear();
    _banner();
    print "Main Menu\n\n";
    printf "  1) Run toolkit scripts  (%d available)\n", scalar @ALL_TOOLS;
    print "  2) List scripts (CLI)\n";
    print "  3) Launch IDE\n";
    print "  4) Exit\n";
    print "\n  Tip: choose 1 then type / to search/filter scripts\n";
    print "\nChoice: ";
    my $line = <STDIN>;
    unless (defined $line) { print "\nGoodbye.\n"; exit 0 }
    chomp(my $choice = $line);

    if ($choice eq '1') {
        _show_tool_menu();
        next;
    }
    elsif ($choice eq '2') {
        _clear();
        _banner();
        if (-x $CLI_BIN) {
            system($CLI_BIN, 'list');
        } else {
            print "hb_perl_cli not found at: $CLI_BIN\n";
        }
        _pause();
        next;
    }
    elsif ($choice eq '3') {
        exec $^X, $IDE_BIN;
        die "Failed to launch IDE: $!";
    }
    elsif ($choice eq '4' || $choice =~ /^[qQ]$/) {
        print "\nGoodbye.\n";
        exit 0;
    }

    print "\nInvalid selection.\n";
    _pause();
}

__END__

=head1 NAME

hb_perl_tui - Terminal UI menu for the HB Perl toolkit

=head1 SYNOPSIS

    hb_perl_tui [--help]

=head1 DESCRIPTION

An interactive, full-screen terminal menu that lets you browse and run
the 15 bundled sysadmin scripts, list them, or launch the GTK IDE.
Navigate with number keys; press C<b> to go back.

=head1 MENUS

=over 4

=item B<Main menu>

1) Run toolkit scripts  2) List scripts (CLI)  3) Launch IDE  4) Exit

=item B<Script menu>

Lists all toolkit scripts by number.  Select one to run it in the
terminal and display exit status.

=back

=head1 AUTHOR

James

=head1 LICENSE

MIT

=cut
